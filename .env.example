# ==========================================
# SoloSolutionsAI Agent Workforce
# Environment Variables
# ==========================================

# Claude API (powers all 21 agents)
ANTHROPIC_API_KEY=

# Google Workspace (Gmail — Riley reads support emails, Jordan sends replies)
GOOGLE_SERVICE_ACCOUNT_JSON=          # Base64-encoded service account key JSON
GOOGLE_DELEGATED_USER=                # e.g. admin@solosolutionsai.com

# Supabase — Operations Database (agent state, tickets, knowledge base)
SUPABASE_OPS_URL=
SUPABASE_OPS_SERVICE_KEY=

# Supabase — SoloLawyerAI (vertical database)
SUPABASE_SOLOLAWYER_URL=
SUPABASE_SOLOLAWYER_SERVICE_KEY=

# Supabase — SoloVetAI (vertical database)
# SUPABASE_SOLOVET_URL=
# SUPABASE_SOLOVET_SERVICE_KEY=

# Resend (transactional emails — Morgan's onboarding nudges, Sage's re-engagement)
RESEND_API_KEY=

# Founder notifications (escalations from Avery, morning digest)
NOTIFICATION_EMAIL=

# Logging
LOG_LEVEL=info
